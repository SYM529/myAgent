# 复制为 .env 后填写真实值：cp .env.example .env

# 主对话模型：任何 OpenAI 兼容服务商都可以（DeepSeek 官方 / 硅基流动 / OpenRouter 等）
# 未配置时回退使用下面的 DEEPSEEK_* 配置
# LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# LLM_API_KEY=
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# 混合推理模型（如 DeepSeek-V4-Flash）置 1，避免 <think> 思考过程透传到聊天界面
# LLM_DISABLE_THINKING=1

# DeepSeek 官方（LLM_* 未配置时的回退）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Tavily（联网搜索工具）
TAVILY_API_KEY=

# 知识库 RAG：Embedding 与 Rerank（DeepSeek 不提供 embedding，这里用 SiliconFlow）
# 不配置时知识库功能不可用，其余能力不受影响
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Agent 架构：react（单 ReAct 循环，默认且实测更优）/ graph（多 Agent 图）
# AGENT_ARCH=react

# "现在几点"工具使用的时区（IANA 名称）。容器默认 UTC，必须显式指定
# TIMEZONE=Asia/Shanghai

# ---- 限流与并发 ----
# 单用户每分钟允许的 Agent 请求数（<=0 表示关闭限流）
# RATE_LIMIT_PER_MIN=20
# 滑动窗口长度（秒）
# RATE_LIMIT_WINDOW=60
# 同时运行的 Agent 请求上限，超出直接返回 503（不排队，排队比拒绝更伤）
# AGENT_MAX_CONCURRENCY=8
# 登录尝试限流（按用户名，每分钟，<=0 表示关闭）——防止暴力破解
# AUTH_RATE_LIMIT_PER_MIN=10
# 上传限流（按登录用户，每分钟，<=0 表示关闭）——上传会触发解析与 Embedding 计费
# UPLOAD_RATE_LIMIT_PER_MIN=10

# ---- 长上下文压缩 ----
# 历史超过多少条触发摘要压缩（必须小于主角色的 MAX_HISTORY=20，否则永远触发不了）
# COMPRESS_TRIGGER=16
# 单次压缩时原样保留的最近消息数
# COMPRESS_KEEP_RECENT=8
# 历史总字符数超过该值也触发压缩
# COMPRESS_MAX_CHARS=6000
# 摘要调用的超时秒数，超时就放弃本次压缩
# COMPRESS_TIMEOUT=10

# ---- 多模态（图片理解）----
# 主模型 deepseek-chat 不支持多模态，图片单独走一个视觉模型。
# 未配置时图片理解不挂载，其余能力不受影响。
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# VISION_BASE_URL=https://api.siliconflow.cn/v1
# 依次回退 VISION_API_KEY -> EMBEDDING_API_KEY -> SILICON_API_KEY
# VISION_API_KEY=
# 单张图片上限（会编码成 base64 计费，比普通附件敏感得多）
# VISION_MAX_IMAGE_MB=5
# VISION_ENABLED=auto

# ---- 语义缓存 ----
# 相似度阈值。默认值 0.92 由 `python -m evals.cache_calibrate` 标定得出：
# 148 条评测集上可缓存问题的最大相似度 0.8763，误命中 0 条，余量 0.0437。
# 改动前请先重跑标定脚本。
# CACHE_MIN_SIMILARITY=0.92
# CACHE_TTL=3600
# CACHE_MAX_ENTRIES=500
# CACHE_ENABLED=auto

# ---- 计费（元 / 百万 token，评测与线上共用）----
# PRICE_INPUT=2.0
# PRICE_OUTPUT=8.0

# ---- 文件上传 ----
# 上传文件落地目录（图片用于本次看图，文档直接增量入库）
# UPLOAD_DIR=./uploads
# UPLOAD_MAX_IMAGE_MB=10
# UPLOAD_MAX_DOC_MB=20

# ---- MCP Server ----
# stdio 给 Claude Desktop / Cursor 这类本地客户端；streamable-http 用于远程部署
# MCP_TRANSPORT=stdio
# MCP_SERVER_NAME=agent-tools

# RAG 可调参数（可选，均有默认值）
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# RAG_TOP_K=4
# rerank 低分过滤阈值。默认 0.002 由实测分数分布标定（相关最高 0.97，
# 不相关 ≤0.0004）；旧值 0.05 会误杀低分正确答案，勿改回
# RAG_MIN_SCORE=0.002
# RAG_ENABLED=auto

# JWT 签名密钥（必填，服务启动时会校验）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# 管理员用户名名单（逗号分隔）：名单内账号可访问评测看板，留空则无人是管理员
# ADMIN_USERS=your_admin_name

# ---- 公网部署 ----
# 前端监听端口：云服务器上设为 80
# FRONTEND_PORT=80
# 注册开关：先建好自己的账号，然后设为 0 关闭注册口
# （注册消耗的是你的 API 额度，公网上敞开注册等于把账单交给陌生人）
# REGISTER_ENABLED=0

# 允许访问后端的前端来源，逗号分隔（默认覆盖 Vite 开发地址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库（用户表 / 审计日志）----
# 本地开发用 MySQL 8（推荐，需先建库）：
#   CREATE DATABASE agent CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/agent?charset=utf8mb4
# docker compose 里 MySQL 容器的 root 密码（mysql 服务与容器内 DATABASE_URL 引用）
MYSQL_ROOT_PASSWORD=
# 未配置 DATABASE_URL 时回落 SQLite（单测与迁移测试不依赖 MySQL）

# 会话存储
REDIS_URL=redis://localhost:6379/0
# 会话保留时长（小时）。默认 168 = 7 天：侧边栏的历史对话需要能存活
# SESSION_TTL_HOURS=168

# 可选：LangSmith 链路追踪
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=agent-demo
