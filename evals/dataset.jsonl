{"id": "time_010", "category": "time_query", "input": "今年是哪一年", "expect_tools": ["get_current_time"], "tool_match": "any", "judge": {"type": "regex", "pattern": "20\\d{2}"}, "requires_network": false, "notes": "年份不能靠训练记忆"}
{"id": "time_011", "category": "time_query", "input": "现在几点了？请用 24 小时制告诉我", "expect_tools": ["get_current_time"], "tool_match": "any", "judge": {"type": "regex", "pattern": "\\d{1,2}[:：][0-5]\\d|\\d{1,2}\\s*点"}, "requires_network": false, "notes": "时刻表达（ISO 或中文点分均可）"}
